pipeline {
    agent any

    environment {
        PYTHON_VERSIONS = "3.8,3.9" // Store as a comma-separated string
        DOCKERHUB_CREDENTIALS = 'd651925e-4d82-44d1-9cfe-618f30b38b0c' // DockerHub credentials ID
        REPO_NAME = 'olego700/python-fake-data-app' // DockerHub repository name
        GITHUB_REPO = "https://github.com/olego700/devopshift-welcome.git" // GitHub repository URL
        GITHUB_BRANCH = 'jenkins-workshop' // GitHub repository branch
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: "${GITHUB_BRANCH}", url: "${GITHUB_REPO}"
            }
        }

        stage('Install Dependencies') {
            agent {
                docker {
                    image 'python:3.8' // Use any Python version for dependency installation
                    args '-v $HOME/.cache/pip:/root/.cache/pip'
                }
            }
            steps {
                sh 'pip install faker'
            }
        }

        stage('Test Application') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values {
                            script {
                                return PYTHON_VERSIONS.split(',')
                            }
                        }
                    }
                }
                stages {
                    stage('Run Test') {
                        agent {
                            docker {
                                image "python:${PYTHON_VERSION}"
                                reuseNode true
                            }
                        }
                        steps {
                            sh 'python app.py'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values {
                            script {
                                return PYTHON_VERSIONS.split(',')
                            }
                        }
                    }
                }
                stages {
                    stage('Build Image') {
                        steps {
                            script {
                                docker.build("${REPO_NAME}:${PYTHON_VERSION}", "--build-arg PYTHON_VERSION=${PYTHON_VERSION} .")
                            }
                        }
                    }
                }
            }
        }

        stage('Push to DockerHub') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VERSION'
                        values {
                            script {
                                return PYTHON_VERSIONS.split(',')
                            }
                        }
                    }
                }
                stages {
                    stage('Push Image') {
                        steps {
                            script {
                                docker.withRegistry('https://index.docker.io/v1/', DOCKERHUB_CREDENTIALS) {
                                    docker.image("${REPO_NAME}:${PYTHON_VERSION}").push()
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline completed."
        }
    }
}
